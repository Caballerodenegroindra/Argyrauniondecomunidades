rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Solo el administrador principal fijo "indrhack" (no los demás admins
    // que él otorgue) puede administrar la lista de Líderes / Alto Consejo.
    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nick.lower() == 'indrhack';
    }

    // Solo cuentas ya aceptadas en la comunidad pueden ver la sección
    // "Comunidad" (lista de miembros y grupos por rango).
    function isApprovedMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/directory/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/directory/$(request.auth.uid)).data.status == 'accepted';
    }

    // Mapeo nick -> {uid, email}. Necesita lectura pública porque el login
    // por nick busca aquí ANTES de que la persona esté autenticada.
    // Solo expone el correo asociado a un nick, nunca contraseñas
    // (Firebase Auth jamás guarda ni expone contraseñas en Firestore).
    match /usernames/{nick} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // Perfil de cada usuario.
    match /users/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // El dueño puede editar su propio perfil MIENTRAS no esté resuelto
      // (para completar encuesta/enviar solicitud). Ya con status
      // accepted/rejected, solo un admin puede tocar el documento
      // (para asignar o cambiar rango).
      allow update: if isAdmin() || (
        request.auth.uid == uid &&
        resource.data.status != "accepted" &&
        resource.data.status != "rejected"
      );
      allow delete: if isAdmin();
    }

    // Directorio público de miembros: solo nick, rango(s) y estado (sin
    // teléfono ni correo). Solo miembros ya aceptados (o admins) pueden
    // ver la lista completa (para la sección "Comunidad"); cada quien
    // crea su propia entrada al registrarse y solo un admin puede
    // tocarla una vez resuelta.
    match /directory/{uid} {
      allow read: if isApprovedMember() || isAdmin();
      // El dueño crea su propia entrada al registrarse; un admin también
      // puede crearla/actualizarla (por ejemplo, para "poner al día" a
      // cuentas que ya existían antes de esta sección).
      allow create: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (
        request.auth.uid == uid &&
        resource.data.status != "accepted" &&
        resource.data.status != "rejected"
      );
      allow delete: if isAdmin();
    }

    // Grupos por función/proyecto (ej. "Grupo de Programación"). Cada uno
    // puede estar restringido a uno o más rangos; si "ranks" está vacío,
    // el grupo es visible para cualquier miembro aceptado.
    match /groups/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Noticias / información de la comunidad que se ve al iniciar sesión.
    // Cualquier admin (indrhack u otro admin otorgado) puede publicar.
    match /news/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Cúpula y Alto Consejo. Cada entrada guarda una copia del nombre y
    // teléfono del usuario líder para poder mostrarlo y contactarlo por
    // WhatsApp. Solo "indrhack" (isSuperAdmin) puede agregar o quitar
    // líderes; cualquier persona con cuenta puede ver la lista.
    match /leaders/{uid} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Lista de administradores.
    // - "indrhack" es el admin principal: se auto-otorga el acceso la
    //   primera vez que inicia sesión (bootstrap), y solo puede hacerlo
    //   para su propia cuenta.
    // - Cualquier administrador ya existente puede otorgar o quitar el
    //   acceso a otras personas desde el panel.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        get(/databases/$(database)/documents/users/$(uid)).data.nick.lower() == 'indrhack'
      );
      allow update, delete: if isAdmin();
    }
  }
}
