rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Solo "indrhack" puede otorgar/quitar el rol de Líder directamente
    // desde datos sensibles (en la práctica los admins ya cubren la gestión
    // diaria; se deja reservado para el admin principal).
    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nick.lower() == 'indrhack';
    }

    function isApprovedMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/directory/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/directory/$(request.auth.uid)).data.status == 'accepted';
    }

    // Mapeo nick -> {uid, email}. Lectura pública: el login por nick busca
    // aquí antes de que la persona esté autenticada.
    match /usernames/{nick} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // Perfil privado de cada usuario (incluye teléfono/correo).
    match /users/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // El dueño puede editar su propio perfil mientras no esté resuelto
      // (encuesta de ingreso / términos) o para su teléfono; solo un admin
      // puede tocar el documento una vez aceptado/rechazado o para
      // asignar rol, rama, comunidad y sello.
      allow update: if isAdmin() || (
        request.auth.uid == uid &&
        resource.data.status != "accepted" &&
        resource.data.status != "rejected"
      ) || (
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["phone"])
      );
      allow delete: if isAdmin();
    }

    // Directorio público reducido: nick, rol, rama(s), comunidad, sello,
    // status. Sin teléfono ni correo. Visible para miembros ya aceptados
    // y admins (se usa en Comunidades, Equipo y Líderes).
    match /directory/{uid} {
      allow read: if isApprovedMember() || isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (
        request.auth.uid == uid &&
        resource.data.status != "accepted" &&
        resource.data.status != "rejected"
      );
      allow delete: if isAdmin();
    }

    // Comunidades y grupos independientes afiliados a Argyra.
    match /communities/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // Embajada: espacio privado de cada comunidad. Solo lo leen/escriben
      // miembros de esa comunidad, líderes, coordinadores de Relaciones
      // Externas, o admins.
      match /embassy/{msgId} {
        function myProfile() {
          return get(/databases/$(database)/documents/directory/$(request.auth.uid)).data;
        }
        function canAccessEmbassy() {
          return isSignedIn() && (
            isAdmin() ||
            (isApprovedMember() && myProfile().communityId == id) ||
            (isApprovedMember() && myProfile().role == 'lider') ||
            (isApprovedMember() && myProfile().role == 'coordinador' &&
              ('relaciones' in myProfile().branches))
          );
        }
        allow read, create: if canAccessEmbassy();
        allow update, delete: if isAdmin();
      }
    }

    // Directorio Central: anuncios globales o por comunidad.
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() || (
          isApprovedMember() &&
          exists(/databases/$(database)/documents/directory/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/directory/$(request.auth.uid)).data.role == 'lider' ||
            (
              get(/databases/$(database)/documents/directory/$(request.auth.uid)).data.role == 'coordinador' &&
              ('relaciones' in get(/databases/$(database)/documents/directory/$(request.auth.uid)).data.branches)
            )
          )
        )
      );
      allow update, delete: if isAdmin();
    }

    // Sistema de pase: solicitud para ser Coordinador de una rama.
    match /passRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Noticias generales (compatibilidad; ya no se usa como pantalla
    // principal, reemplazada por Directorio Central / announcements).
    match /news/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Lista de administradores.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        get(/databases/$(database)/documents/users/$(uid)).data.nick.lower() == 'indrhack'
      );
      allow update, delete: if isAdmin();
    }
  }
}
